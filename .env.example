# Copy this file to .env. Weather requests go through the Cloudflare
# Worker proxy in server/ (see server/.dev.vars.example) -- the app itself
# never needs a real OpenWeatherMap key.
EXPO_PUBLIC_WEATHER_PROXY_URL=https://weathernow-proxy.your_subdomain.workers.dev
EXPO_PUBLIC_WEATHER_PROXY_KEY=your_shared_secret_here
